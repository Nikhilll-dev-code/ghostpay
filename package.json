{
  "name": "ghost-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:shared": "npm run build --workspace=@ghost/shared",
    "build:api": "npm run build --workspace=@ghost/api",
    "build:web": "npm run build --workspace=@ghost/web",
    "build": "npm run build:shared && npm run build:api && npm run build:web",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev --workspace=@ghost/api",
    "dev:web": "npm run dev --workspace=@ghost/web",
    "test:api": "npm run test --workspace=@ghost/api",
    "test:shared": "npm run test --workspace=@ghost/shared",
    "test": "npm run test:shared && npm run test:api && npm run test:web",
    "db:push": "prisma db push --schema=./prisma/schema.prisma",
    "db:seed": "tsx ./prisma/seed.ts",
    "test:web": "npm run test --workspace=@ghost/web",
    "lint:design": "npm run lint:design --workspace=@ghost/web"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prisma": "^6.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
